<Page x:Class="XAU.Views.Pages.GamesPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:local="clr-namespace:XAU.Views.Pages"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
      Title="GamesPage"
      d:DataContext="{d:DesignInstance local:GamesPage, IsDesignTimeCreatable=False}"
      d:DesignHeight="700"
      d:DesignWidth="1100"
      ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
      ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      Foreground="{DynamicResource TextFillColorPrimaryBrush}"
      mc:Ignorable="d">

    <Grid Margin="16,10,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="{Binding ViewModel.GamesListHeight}"/>
            <RowDefinition Height="{Binding ViewModel.LoadingHeight}"/>
        </Grid.RowDefinitions>

        <!-- 1. Modern Unified Filter & Search Bar -->
        <Border Grid.Row="0" Margin="0,0,0,12" Padding="12,10" Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="180" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="160" />
                    <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>

                <!-- XUID Input / Refresh -->
                <Grid Grid.Column="0" Margin="0,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBox
                        Grid.Column="0"
                        x:Name="XUIDBox"
                        IsEnabled="{Binding ViewModel.IsInitialized}"
                        PlaceholderText="XUID"
                        Padding="8,4"
                        Text="{Binding ViewModel.XuidOverride, Mode=TwoWay}"
                        ClearButtonEnabled="False" />
                    <ui:Button
                        Grid.Column="1"
                        x:Name="RefreshButton"
                        IsEnabled="{Binding ViewModel.IsInitialized}"
                        Margin="4,0,0,0"
                        Padding="8,4"
                        ToolTip="Refresh Games List"
                        Icon="{ui:SymbolIcon ArrowSync24}"
                        Command="{Binding ViewModel.GetGamesListCommand}" />
                </Grid>

                <!-- Search Box -->
                <Grid Grid.Column="1" Margin="0,0,10,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <ui:TextBox
                        Grid.Column="0"
                        x:Name="SearchBox"
                        IsEnabled="{Binding ViewModel.IsInitialized}"
                        Padding="10,4"
                        Text="{Binding ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        PlaceholderText="Search games by title..."
                        ClearButtonEnabled="True"
                        KeyDown="SearchBox_OnKeyDown" />
                    <ui:Button
                        Grid.Column="1"
                        x:Name="SearchButton"
                        IsEnabled="{Binding ViewModel.IsInitialized}"
                        Margin="4,0,0,0"
                        Padding="8,4"
                        Icon="{ui:SymbolIcon Search24}"
                        Command="{Binding ViewModel.SearchAndFilterGamesCommand}" />
                </Grid>

                <!-- Filter Dropdown -->
                <ComboBox
                    Grid.Column="2"
                    x:Name="FilterBox"
                    Margin="0,0,10,0"
                    IsEnabled="{Binding ViewModel.IsInitialized}"
                    Padding="10,4"
                    ItemsSource="{Binding ViewModel.FilterOptions}"
                    SelectedIndex="{Binding ViewModel.FilterIndex, Mode=TwoWay}" />

                <!-- Sort Dropdown -->
                <ComboBox
                    Grid.Column="3"
                    x:Name="SortBox"
                    Margin="0,0,10,0"
                    IsEnabled="{Binding ViewModel.IsInitialized}"
                    Padding="10,4"
                    ItemsSource="{Binding ViewModel.SortOptions}"
                    SelectedIndex="{Binding ViewModel.SortIndex, Mode=TwoWay}" />

                <!-- Page Dropdown -->
                <ComboBox
                    Grid.Column="4"
                    x:Name="PageBox"
                    IsEnabled="{Binding ViewModel.IsInitialized}"
                    Padding="10,4"
                    ItemsSource="{Binding ViewModel.PageOptions, Mode=OneWay}"
                    SelectionChanged="PageBox_OnSelectionChanged"
                    SelectedIndex="{Binding ViewModel.CurrentPage, Mode=TwoWay}" />
            </Grid>
        </Border>

        <!-- Loading Ring -->
        <ui:ProgressRing IsIndeterminate="True" Grid.Row="2" 
                         VerticalAlignment="Center" 
                         HorizontalAlignment="Center" 
                         Height="{Binding ViewModel.LoadingSize}"
                         Width="{Binding ViewModel.LoadingSize}" />

        <!-- 2. Interactive Game Posters Grid -->
        <ScrollViewer Grid.Row="1" x:Name="GamesScrollViewer"
                      VerticalScrollBarVisibility="Auto" 
                      HorizontalScrollBarVisibility="Disabled"
                      CanContentScroll="False"
                      PreviewMouseWheel="ScrollViewer_PreviewMouseWheel">
            <ItemsControl ItemsSource="{Binding ViewModel.GamesPaged}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Width="175" Margin="7" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1"
                                CornerRadius="10" Padding="0" ClipToBounds="True">
                            <StackPanel Orientation="Vertical">

                                <!-- Poster Image Button -->
                                <Button Cursor="Hand" Click="ButtonBase_OnClick" MouseRightButtonDown="ButtonBase_RightClick"
                                        Content="{Binding Index}" Padding="0" BorderThickness="0" Background="Transparent"
                                        HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch">
                                    <Button.Template>
                                        <ControlTemplate>
                                            <Border CornerRadius="10,10,0,0" ClipToBounds="True">
                                                <ui:Image Source="{Binding Image, IsAsync=true}" Width="175" Height="175"
                                                          Stretch="UniformToFill" Image.ImageFailed="Image_ImageFailed"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Button.Template>
                                </Button>

                                <!-- Bottom Progress & Metadata Section -->
                                <Border Padding="8,6,8,8">
                                    <StackPanel Orientation="Vertical">
                                        <!-- Progress Bar -->
                                        <ProgressBar Value="{Binding NumericProgress}" Maximum="100" Height="4" Margin="0,0,0,6"/>

                                        <!-- Stats Row -->
                                        <Grid Margin="0,0,0,4">
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center">
                                                <ui:SymbolIcon Symbol="Trophy24" Foreground="#FFD700" Margin="0,0,4,0"/>
                                                <TextBlock Text="{Binding CurrentAchievements}" FontSize="11" FontWeight="SemiBold"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Gamerscore}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,3,0"/>
                                                <TextBlock Text="G" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            </StackPanel>
                                        </Grid>

                                        <!-- Title Header -->
                                        <TextBlock Text="{Binding Title}" FontSize="12" FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis" ToolTip="{Binding Title}"
                                                   HorizontalAlignment="Center"/>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Page>
