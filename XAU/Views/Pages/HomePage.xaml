<Page
    x:Class="XAU.Views.Pages.HomePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:XAU.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="HomePage"
    d:DataContext="{d:DesignInstance local:HomePage, IsDesignTimeCreatable=False}"
    d:DesignHeight="750"
    d:DesignWidth="1100"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid Margin="16,10,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Update Notification Banner -->
        <Border Grid.Row="0" Margin="0,0,0,12" VerticalAlignment="Top" HorizontalAlignment="Stretch"
                Background="{DynamicResource ControlFillColorDefaultBrush}"
                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8" Padding="14,10"
                Visibility="{Binding ViewModel.IsUpdateAvailable, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <ui:SymbolIcon Grid.Column="0" Symbol="ArrowDownload24" Margin="0,0,10,0" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                <TextBlock Grid.Column="1" Text="{Binding ViewModel.UpdateVersionText}" FontWeight="SemiBold" VerticalAlignment="Center"/>

                <ui:Button Grid.Column="2" Content="Release Notes" Margin="0,0,8,0" Padding="10,4" Appearance="Secondary" Command="{Binding ViewModel.ViewReleaseNotesCommand}"/>
                <ui:Button Grid.Column="3" Content="Update Now" Padding="12,4" Appearance="Primary" Command="{Binding ViewModel.ApplyAppUpdateCommand}"/>
            </Grid>
        </Border>

        <!-- Scrollable Dashboard Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Vertical">

                <!-- 1. Hero Gamer Profile Card -->
                <Border Margin="0,0,0,14" Padding="18,16" Background="{DynamicResource ControlFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="10">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!-- Left: GamerPic with Accent Border -->
                        <Border Grid.Column="0" Width="104" Height="104" CornerRadius="52"
                                BorderBrush="{DynamicResource AccentFillColorDefaultBrush}" BorderThickness="3"
                                Margin="0,0,18,0" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ui:Image Source="{Binding ViewModel.GamerPic, Mode=OneWay}"
                                      Width="98" Height="98" CornerRadius="49" Stretch="UniformToFill"/>
                        </Border>

                        <!-- Center: Profile Info & Badges -->
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,4">
                                <TextBlock Text="{Binding ViewModel.GamerTag, Mode=OneWay}" FontSize="22" FontWeight="Bold" Margin="0,0,10,0"/>
                                <Border Background="{DynamicResource AccentFillColorDefaultBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center" Margin="0,0,6,0">
                                    <TextBlock Text="{Binding ViewModel.AccountTier, Mode=OneWay}" FontSize="11" FontWeight="SemiBold" Foreground="White"/>
                                </Border>
                                <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding ViewModel.Tenure, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="{Binding ViewModel.Xuid, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,0,0,6"/>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <TextBlock Text="{Binding ViewModel.Location, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,14,0"/>
                                <TextBlock Text="{Binding ViewModel.Followers, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,14,0"/>
                                <TextBlock Text="{Binding ViewModel.Following, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,0,14,0"/>
                                <TextBlock Text="{Binding ViewModel.Gamepass, Mode=OneWay}" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>

                            <TextBlock Text="{Binding ViewModel.Bio, Mode=OneWay}" FontSize="12" FontStyle="Italic"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap" MaxWidth="600"/>
                        </StackPanel>

                        <!-- Right: Gamerscore Card & Action Buttons -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,0,0">
                            <!-- Gamerscore Pill -->
                            <Border Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="8" Padding="14,8" Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <ui:SymbolIcon Symbol="Trophy24" Foreground="#FFD700" Margin="0,0,8,0"/>
                                    <TextBlock Text="{Binding ViewModel.GamerScore, Mode=OneWay}" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                </StackPanel>
                            </Border>

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <ui:Button Content="Refresh" Icon="{ui:SymbolIcon ArrowSync24}" Margin="0,0,6,0" Padding="10,5"
                                           IsEnabled="{Binding ViewModel.IsLoggedIn, Mode=OneWay}"
                                           Command="{Binding ViewModel.RefreshProfileCommand, Mode=OneWay}"/>
                                <ui:Button Content="{Binding ViewModel.LoginText, Mode=OneWay}" Icon="{ui:SymbolIcon Person24}" Padding="12,5"
                                           Appearance="Primary"
                                           Command="{Binding ViewModel.OAuthLoginCommand, Mode=OneWay}"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. Live System & Engine Status Cards -->
                <Grid Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Card 1: Memory Scanner Attach State -->
                    <Border Grid.Column="0" Margin="0,0,6,0" Padding="14,12" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="XboxController24" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="Xbox Process State" FontWeight="SemiBold" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,4">
                                <Ellipse Width="10" Height="10" Fill="{Binding ViewModel.AttachedColor}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ViewModel.Attached}" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ViewModel.ActiveDevice, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 2: Active Presence & Spoofing -->
                    <Border Grid.Column="1" Margin="3,0,3,0" Padding="14,12" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="PlayCircle24" Foreground="#00BFFF" Margin="0,0,6,0"/>
                                <TextBlock Text="Active Presence" FontWeight="SemiBold" FontSize="13"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ViewModel.CurrentlyPlaying, Mode=OneWay}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,2,0,2"/>
                            <TextBlock Text="{Binding ViewModel.ProfileRep, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Border>

                    <!-- Card 3: Session & Events Token Health -->
                    <Border Grid.Column="2" Margin="6,0,0,0" Padding="14,12" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="ShieldKeyhole24" Foreground="#32CD32" Margin="0,0,6,0"/>
                                <TextBlock Text="Session &amp; Telemetry Token" FontWeight="SemiBold" FontSize="13"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,4">
                                <Ellipse Width="10" Height="10" Fill="{Binding ViewModel.LoggedInColor}" Margin="0,0,6,0"/>
                                <TextBlock Text="{Binding ViewModel.LoggedIn}" FontSize="14" FontWeight="Bold"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ViewModel.IsVerified, Mode=OneWay}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 3. Badges Showcase Gallery -->
                <ui:CardExpander Margin="0,0,0,14" IsExpanded="True">
                    <ui:CardExpander.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="RibbonStar24" Foreground="#FFD700" Margin="0,0,8,0"/>
                            <TextBlock Text="Tenure &amp; Launch Badges" FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:CardExpander.Header>

                    <ItemsControl ItemsSource="{Binding ViewModel.Watermarks}" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="6" Padding="6" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8">
                                    <Image Source="{Binding ImageUrl}" Width="80" Height="80" Stretch="Uniform" />
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ui:CardExpander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
