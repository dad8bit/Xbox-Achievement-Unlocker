<Page
    x:Class="XAU.Views.Pages.StatsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:XAU.Views.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Stats &amp; Showcase"
    d:DataContext="{d:DesignInstance local:StatsPage, IsDesignTimeCreatable=False}"
    d:DesignHeight="700"
    d:DesignWidth="1100"
    ui:Design.Background="{DynamicResource ApplicationBackgroundBrush}"
    ui:Design.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    mc:Ignorable="d">

    <Grid Margin="16,10,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Vertical">
                <ui:TextBlock Text="Stats &amp; Milestone Showcase" FontTypography="Title"/>
                <ui:TextBlock Text="Comprehensive overview of your Gamerscore, 100% mastered games, and completion progress."
                              Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,2,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <ui:ProgressRing IsIndeterminate="True" Width="24" Height="24" Margin="0,0,12,0"
                                  Visibility="{Binding ViewModel.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <ui:Button Content="Refresh Stats" Icon="{ui:SymbolIcon ArrowSync24}"
                           Command="{Binding ViewModel.LoadStatsCommand}"
                           Padding="12,6" Appearance="Primary"/>
            </StackPanel>
        </Grid>

        <!-- Scrollable Content Body -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Orientation="Vertical">

                <!-- 1. Top KPI Summary Tiles -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Gamerscore Card -->
                    <Border Grid.Column="0" Margin="0,0,8,0" Padding="14,12" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="XboxController24" Foreground="{DynamicResource AccentFillColorDefaultBrush}" Margin="0,0,6,0"/>
                                <TextBlock Text="Total Gamerscore" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ViewModel.TotalGamerscore}" FontSize="24" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ViewModel.TotalGamerscorePossible}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Achievements Unlocked Card -->
                    <Border Grid.Column="1" Margin="4,0,4,0" Padding="14,12" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="Ribbon24" Foreground="#FFD700" Margin="0,0,6,0"/>
                                <TextBlock Text="Achievements" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ViewModel.TotalAchievementsUnlocked}" FontSize="24" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ViewModel.TotalAchievementsPossible}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Mastered 100% Games Card -->
                    <Border Grid.Column="2" Margin="4,0,4,0" Padding="14,12" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="Trophy24" Foreground="#FF8C00" Margin="0,0,6,0"/>
                                <TextBlock Text="100% Mastered" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ViewModel.MasteredGamesCount}" FontSize="24" FontWeight="Bold"/>
                            <TextBlock Text="{Binding ViewModel.MasteredGamesPercent}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Average Completion Rate Card -->
                    <Border Grid.Column="3" Margin="8,0,0,0" Padding="14,12" Background="{DynamicResource ControlFillColorDefaultBrush}"
                            BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                <ui:SymbolIcon Symbol="DataPie24" Foreground="#00BFFF" Margin="0,0,6,0"/>
                                <TextBlock Text="Avg Completion" FontWeight="SemiBold" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding ViewModel.AverageCompletionRate}" FontSize="24" FontWeight="Bold"/>
                            <ProgressBar Value="{Binding ViewModel.AverageCompletionProgress}" Maximum="100" Height="4" Margin="0,6,0,0"/>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- 2. Platform Breakdown -->
                <ui:CardControl Margin="0,0,0,16" Padding="14,10">
                    <ui:CardControl.Header>
                        <StackPanel Orientation="Horizontal">
                            <ui:SymbolIcon Symbol="DeviceLaptop24" Margin="0,0,8,0" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                            <TextBlock Text="Platform Breakdown" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                        </StackPanel>
                    </ui:CardControl.Header>
                    <Grid Margin="0,6,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- Console -->
                        <Border Grid.Column="0" Margin="0,0,6,0" Padding="10,8" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="Xbox Series / One" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding ViewModel.ConsoleGamerscore}" FontSize="18" FontWeight="Bold" Margin="0,2,0,0" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <TextBlock Text="{Binding ViewModel.ConsoleGamesCount}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- PC -->
                        <Border Grid.Column="1" Margin="3,0,3,0" Padding="10,8" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="PC / Windows" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding ViewModel.PcGamerscore}" FontSize="18" FontWeight="Bold" Margin="0,2,0,0" Foreground="#00BFFF"/>
                                <TextBlock Text="{Binding ViewModel.PcGamesCount}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                        </Border>

                        <!-- Xbox 360 -->
                        <Border Grid.Column="2" Margin="6,0,0,0" Padding="10,8" Background="{DynamicResource ControlFillColorSecondaryBrush}" CornerRadius="6">
                            <StackPanel>
                                <TextBlock Text="Xbox 360" FontWeight="SemiBold" FontSize="13"/>
                                <TextBlock Text="{Binding ViewModel.Xbox360Gamerscore}" FontSize="18" FontWeight="Bold" Margin="0,2,0,0" Foreground="#32CD32"/>
                                <TextBlock Text="{Binding ViewModel.Xbox360GamesCount}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                </ui:CardControl>

                <!-- 3. Mastered Games Showcase (100% Completed) -->
                <ui:CardExpander Margin="0,0,0,16" IsExpanded="True">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="Trophy24" Foreground="#FFD700" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="100% Mastered Games Showcase" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding ViewModel.MasteredGames.Count, StringFormat='{}{0} Games Completed'}"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        </Grid>
                    </ui:CardExpander.Header>

                    <ItemsControl ItemsSource="{Binding ViewModel.MasteredGames}" Margin="0,6,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="240" Margin="6" Padding="10" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="#FFD700" BorderThickness="1" CornerRadius="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <!-- Top Info -->
                                        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
                                            <Border CornerRadius="4" Background="#FFD700" Padding="4,1" Margin="0,0,6,0">
                                                <TextBlock Text="100%" FontWeight="Bold" FontSize="10" Foreground="Black"/>
                                            </Border>
                                            <TextBlock Text="{Binding Platform}" FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <!-- Title -->
                                        <TextBlock Grid.Row="1" Text="{Binding Title}" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis" Margin="0,0,0,4"/>

                                        <!-- Gamerscore & Ach -->
                                        <StackPanel Grid.Row="2" Orientation="Vertical">
                                            <TextBlock Text="{Binding GamerscoreText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentFillColorDefaultBrush}"/>
                                            <TextBlock Text="{Binding AchievementsText}" FontSize="10" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ui:CardExpander>

                <!-- 4. Near-Completion In-Progress Games -->
                <ui:CardExpander Margin="0,0,0,16" IsExpanded="True">
                    <ui:CardExpander.Header>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <ui:SymbolIcon Grid.Column="0" Symbol="TargetArrow24" Foreground="#00BFFF" Margin="0,0,8,0"/>
                            <TextBlock Grid.Column="1" Text="Closest to 100% Mastery" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center"/>
                        </Grid>
                    </ui:CardExpander.Header>

                    <ItemsControl ItemsSource="{Binding ViewModel.InProgressGames}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="12,8" Background="{DynamicResource ControlFillColorDefaultBrush}"
                                        BorderBrush="{DynamicResource ControlElevationBorderBrush}" BorderThickness="1" CornerRadius="6">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="2*"/>
                                            <ColumnDefinition Width="3*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <TextBlock Grid.Column="0" Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0"/>

                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0">
                                            <Grid Margin="0,0,0,2">
                                                <TextBlock HorizontalAlignment="Left" Text="{Binding GamerscoreText}" FontSize="11" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                                <TextBlock HorizontalAlignment="Right" Text="{Binding ProgressText}" FontSize="11" FontWeight="Bold"/>
                                            </Grid>
                                            <ProgressBar Value="{Binding ProgressPercentage}" Maximum="100" Height="6"/>
                                        </StackPanel>

                                        <TextBlock Grid.Column="2" Text="{Binding RemainingAchievementsText}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ui:CardExpander>

            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
